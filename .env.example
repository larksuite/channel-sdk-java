# Copy this file to .env and populate it locally. Never commit .env or credentials.
APP_ID=
APP_SECRET=

# Required for P0 smoke E2E
CHANNEL_E2E_RECEIVE_OPEN_ID=
CHANNEL_E2E_GROUP_CHAT_ID=
CHANNEL_E2E_MENTION_USER_OPEN_ID=

# Required for the document-comment event case
CHANNEL_E2E_DOC_TOKEN=

# Required for full policy and share-card coverage
CHANNEL_E2E_ALLOWED_GROUP_CHAT_ID=
CHANNEL_E2E_BLOCKED_GROUP_CHAT_ID=
CHANNEL_E2E_ALLOWED_USER_OPEN_ID=
CHANNEL_E2E_BLOCKED_USER_OPEN_ID=
CHANNEL_E2E_SHARE_CHAT_ID=

# Required only for event.bot_added. Use a dedicated group that does not already contain the bot.
CHANNEL_E2E_BOT_ADDED_CHAT_ID=

# Optional: omit to skip sticker coverage
CHANNEL_E2E_STICKER_FILE_KEY=

# Optional: use only for an approved non-default environment.
# The Java SDK supports one shared domain for OpenAPI and WebSocket traffic.
CHANNEL_E2E_DOMAIN=

# Fixture paths are relative to the repository root. The defaults below are committed test-only fixtures.
CHANNEL_E2E_IMAGE_JPG=./testdata/e2e/image.jpg
CHANNEL_E2E_IMAGE_PNG=./testdata/e2e/image.png
CHANNEL_E2E_IMAGE_GIF=./testdata/e2e/image.gif
CHANNEL_E2E_IMAGE_WEBP=./testdata/e2e/image.webp
CHANNEL_E2E_FILE_PDF=./testdata/e2e/file.pdf
CHANNEL_E2E_FILE_DOCX=./testdata/e2e/file.docx
CHANNEL_E2E_FILE_XLSX=./testdata/e2e/file.xlsx
CHANNEL_E2E_FILE_PPTX=./testdata/e2e/file.pptx
CHANNEL_E2E_AUDIO_OGG=./testdata/e2e/audio.ogg
CHANNEL_E2E_VIDEO_MP4=./testdata/e2e/video.mp4
CHANNEL_E2E_VIDEO_COVER_IMAGE=./testdata/e2e/video-cover.jpg

# Execution gates are deliberately read only from the process environment, not this file.
# LARK_CHANNEL_E2E_ENABLED=true
# LARK_CHANNEL_E2E_DRY_RUN=true
# LARK_CHANNEL_E2E_MANUAL=true
# LARK_CHANNEL_E2E_FOCUSED_COMMENT=true
# LARK_CHANNEL_E2E_ENABLE_POLICY=true
# LARK_CHANNEL_E2E_ENABLE_BOT_ADDED=true
